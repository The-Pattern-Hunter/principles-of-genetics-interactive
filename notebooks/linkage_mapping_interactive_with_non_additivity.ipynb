   "source": [
    "## Part 6: Non-Additivity in Genetic Mapping\n",
    "\n",
    "### Why A-B (10 cM) + B-C (20 cM) ≠ A-C (30 cM)\n",
    "\n",
    "**Key Insights:**\n",
    "- Genetic distances are NOT simply additive\n",
    "- Interference between crossover events\n",
    "- Multiple crossovers can 'cancel out'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def demonstrate_non_additivity():\n",
    "    \"\"\"Visualization of non-additive genetic mapping\"\"\"\n",
    "    def calculate_total_distance(ab_dist, bc_dist):\n",
    "        \"\"\"Calculate total genetic distance accounting for interference\"\"\"\n",
    "        # Simple additive distance\n",
    "        simple_total = ab_dist + bc_dist\n",
    "        \n",
    "        # Interference factor (reduces double crossover probability)\n",
    "        interference_factor = 0.5  # Typical interference value\n",
    "        \n",
    "        # Vector-like distance calculation\n",
    "        adjusted_total = np.sqrt(\n",
    "            (ab_dist/100)**2 + \n",
    "            (bc_dist/100)**2 - \n",
    "            2 * (ab_dist/100) * (bc_dist/100) * interference_factor\n",
    "        ) * 100\n",
    "        \n",
    "        return simple_total, adjusted_total\n",
    "    \n",
    "    plt.figure(figsize=(15, 10))\n",
    "    plt.suptitle('Non-Additivity in Genetic Mapping', fontsize=16)\n",
    "    \n",
    "    # Chromosome Representation\n",
    "    plt.subplot(2, 2, 1)\n",
    "    plt.title('Chromosome Segment Mapping')\n",
    "    plt.xlim(0, 10)\n",
    "    plt.ylim(0, 5)\n",
    "    plt.axis('off')\n",
    "    \n",
    "    # Draw chromosome\n",
    "    plt.plot([1, 9], [2.5, 2.5], 'k-', linewidth=5)\n",
    "    plt.plot(2, 2.5, 'ro', markersize=15, label='Gene A')\n",
    "    plt.plot(5, 2.5, 'go', markersize=15, label='Gene B')\n",
    "    plt.plot(8, 2.5, 'bo', markersize=15, label='Gene C')\n",
    "    \n",
    "    # Annotate distances\n",
    "    plt.text(3, 2.2, '10 cM', color='red', ha='center')\n",
    "    plt.text(6.5, 2.2, '20 cM', color='green', ha='center')\n",
    "    \n",
    "    # Distance Comparison\n",
    "    plt.subplot(2, 2, 2)\n",
    "    plt.title('Genetic Distance Comparison')\n",
    "    \n",
    "    # Multiple scenarios\n",
    "    scenarios = [\n",
    "        (10, 20),   # Standard case\n",
    "        (15, 25),   # Larger distances\n",
    "        (5, 15)     # Shorter distances\n",
    "    ]\n",
    "    \n",
    "    distances = []\n",
    "    for ab_dist, bc_dist in scenarios:\n",
    "        simple_total, adjusted_total = calculate_total_distance(ab_dist, bc_dist)\n",
    "        distances.append((ab_dist, bc_dist, simple_total, adjusted_total))\n",
    "    \n",
    "    # Prepare bar plot data\n",
    "    labels = ['Scenario 1', 'Scenario 2', 'Scenario 3']\n",
    "    simple_totals = [d[2] for d in distances]\n",
    "    adjusted_totals = [d[3] for d in distances]\n",
    "    \n",
    "    x = np.arange(len(labels))\n",
    "    width = 0.35\n",
    "    \n",
    "    plt.bar(x - width/2, simple_totals, width, label='Simple Additive', color='red')\n",
    "    plt.bar(x + width/2, adjusted_totals, width, label='Adjusted', color='green')\n",
    "    \n",
    "    plt.ylabel('Genetic Distance (cM)')\n",
    "    plt.title('Non-Additivity Demonstration')\n",
    "    plt.xticks(x, labels)\n",
    "    plt.legend()\n",
    "    \n",
    "    # Detailed Explanation\n",
    "    plt.subplot(2, 2, 3)\n",
    "    plt.title('Why Non-Additivity Occurs')\n",
    "    explanation = (\n",
    "        \"Non-Additivity Explained:\\n\"\n",
    "        \"1. Crossover events interfere with each other\\n\"\n",
    "        \"2. Multiple crossovers can 'cancel out'\\n\"\n",
    "        \"3. Not a simple linear process\\n\\n\"\n",
    "        \"Key Factors:\\n\"\n",
    "        \"- Interference factor\\n\"\n",
    "        \"- Probability of double crossovers\"\n",
    "    )\n",
    "    plt.text(0.1, 0.5, explanation, fontsize=10, \n",
    "             bbox=dict(facecolor='wheat', alpha=0.3))\n",
    "    plt.axis('off')\n",
    "    \n",
    "    # Print detailed results\n",
    "    plt.subplot(2, 2, 4)\n",
    "    plt.title('Detailed Results')\n",
    "    results_text = \"Scenario Details:\\n\"\n",
    "    for i, (ab_dist, bc_dist, simple_total, adjusted_total) in enumerate(distances, 1):\n",
    "        results_text += (\n",
    "            f\"Scenario {i}:\\n\"\n",
    "            f\"A-B Distance: {ab_dist} cM\\n\"\n",
    "            f\"B-C Distance: {bc_dist} cM\\n\"\n",
    "            f\"Simple Total: {simple_total} cM\\n\"\n",
    "            f\"Adjusted Total: {adjusted_total:.2f} cM\\n\\n\"\n",
    "        )\n",
    "    plt.text(0.1, 0.5, results_text, fontsize=8, \n",
    "             bbox=dict(facecolor='lightblue', alpha=0.3))\n",
    "    plt.axis('off')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# Call the function\n",
    "demonstrate_non_additivity()"
   ]
  }
 ]
}
